# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Model weights (downloaded or trained; keep out of git) ---
*.pt
*.onnx
*.engine
models/*.pt
models/*.onnx
models/*.mat

# --- Data ---
# input/  holds the things you analyze. The tiny synthetic wall.jpg is tracked
#         as a smoke-test sample; real gym photos (*.jpeg/*.jpg) and videos stay
#         local, out of the public repo. output/ is fully generated — nothing in
#         it is committed except the .gitkeep that preserves the dir.
data/input/*.jpeg
data/input/*.jpg
data/input/**/*.jpeg
data/input/**/*.jpg
!data/input/wall.jpg
data/output/*
!data/output/.gitkeep
# bootstrap labels + copied private photos (regenerate with scripts/export_for_annotation.py)
data/annotation/
# pose annotation bundle: frames from private clips + RTMPose pre-labels (scripts/export_pose_frames.py)
data/pose_annotation/
*.mp4
*.mov
*.avi

# --- Jupyter ---
.ipynb_checkpoints/

# --- Tooling / OS ---
.DS_Store
.idea/
.vscode/
*.log
.pytest_cache/
.coverage
htmlcov/

# --- Secrets / local config ---
.env
*.local.yaml

# mediapipe task models
models/*.task
