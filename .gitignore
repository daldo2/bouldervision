# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Model weights (downloaded or trained; keep out of git) ---
*.pt
*.onnx
*.engine
models/*.pt
models/*.onnx

# --- Data ---
# input/  holds the things you analyze. Small sample images (e.g. wall.jpg) are
#         tracked; large media (videos) are not. output/ is fully generated, so
#         nothing in it is committed except the .gitkeep that preserves the dir.
data/output/*
!data/output/.gitkeep
*.mp4
*.mov
*.avi

# --- Jupyter ---
.ipynb_checkpoints/

# --- Tooling / OS ---
.DS_Store
.idea/
.vscode/
*.log
.pytest_cache/
.coverage
htmlcov/

# --- Secrets / local config ---
.env
*.local.yaml
