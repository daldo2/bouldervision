# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Model weights (downloaded or trained; keep out of git) ---
*.pt
*.onnx
*.engine
models/*.pt
models/*.onnx

# --- Data: raw + generated outputs are large; never commit ---
# (but keep the empty dirs in git via their .gitkeep so the structure survives a clone)
data/raw/*
!data/raw/.gitkeep
data/annotated/*
!data/annotated/.gitkeep
data/samples/output*.jpg
data/samples/output*.png
data/samples/output*.mp4
*.mp4
*.mov
*.avi

# --- Jupyter ---
.ipynb_checkpoints/

# --- Tooling / OS ---
.DS_Store
.idea/
.vscode/
*.log
.pytest_cache/
.coverage
htmlcov/

# --- Secrets / local config ---
.env
*.local.yaml
